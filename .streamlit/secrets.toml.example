# Plantilla de secretos para Streamlit Cloud.
#
# IMPORTANTE
#   - En local NO crees el archivo .streamlit/secrets.toml a menos que
#     quieras activar el login en tu Mac. Sin el archivo, no hay login
#     (flujo de desarrollo).
#   - En Streamlit Cloud, pega el contenido de este archivo (con tus
#     valores reales) en: Manage app -> Secrets.
#   - NO COMITEES secrets.toml a Git. Esta plantilla (.example) sí va
#     al repo; secrets.toml (real) NO va.

# URL de la base de datos Postgres en Supabase.
# Format: postgresql://USUARIO:PASSWORD@HOST:PUERTO/DB
# La copias desde Supabase -> Project Settings -> Database -> Connection
# string (modo "Session" o "Transaction").
DATABASE_URL = "postgresql://postgres:TU_PASSWORD@db.xxxxxx.supabase.co:5432/postgres"

# Clave secreta para firmar el token de sesion que mantiene el login al
# refrescar el navegador. Genera 32+ caracteres aleatorios y no la
# compartas. Cambiala si sospechas que se ha filtrado (cierra sesiones
# activas).
auth_secret = "cambia_esto_por_32_caracteres_aleatorios_seguros_xxxxxxxx"

# Usuarios de la app. Clave = nombre de usuario, valor = contrasena.
# Ponte una contrasena fuerte para cada uno. Puedes anadir o quitar
# usuarios cuando quieras desde la web de Streamlit Cloud.
[users]
alex = "cambia_esta_clave_alex"
cliente = "cambia_esta_clave_cliente"
